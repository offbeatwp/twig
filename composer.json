{
    "name": "offbeatwp/twig",
    "description": "Use Twig as template engine for OffbeatWP",
    "license": "MIT",
    "type": "offbeatwp-service",
    "scripts": {
        "phpstan": "vendor/bin/phpstan analyse --memory-limit=1G"
    },
    "authors": [
        {
            "name": "Chris Schrijver",
            "email": "chris@raow.nl"
        }
    ],
    "autoload": {
        "psr-4": {
            "OffbeatWP\\Twig\\": "src"
        }
    },
    "require": {
        "php": ">=8.3",
        "twig/twig": "^v3.22.2",
        "offbeatwp/framework": "^4.0.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1.22",
        "szepeviktor/phpstan-wordpress": "^v2.0.2"
    }
}
